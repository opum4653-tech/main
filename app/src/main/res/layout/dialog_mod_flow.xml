<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/card_padding_wide"
    android:paddingTop="@dimen/card_padding_wide"
    android:paddingEnd="@dimen/card_padding_wide"
    android:paddingBottom="@dimen/card_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/dialog_icon"
            android:layout_width="@dimen/icon_md"
            android:layout_height="@dimen/icon_md"
            android:contentDescription="@string/dashboard_kernel_mod"
            android:src="@drawable/ic_warning"
            app:tint="@color/nin_primary" />

        <TextView
            android:id="@+id/dialog_title"
            style="@style/Text.Nin.CardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_weight="1" />

    </LinearLayout>

    <TextView
        android:id="@+id/dialog_message"
        style="@style/Text.Nin.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/dialog_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:visibility="gone"
        app:indicatorColor="@color/nin_primary"
        app:trackColor="@color/nin_surface_variant"
        app:trackThickness="3dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/dialog_terminal"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginTop="@dimen/space_md"
        android:background="@drawable/bg_terminal"
        android:padding="@dimen/space_sm"
        android:scrollbars="vertical"
        android:visibility="gone" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/dialog_input_layout"
        style="@style/Widget.Nin.TextInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:hint="@string/dialog_license_key"
        android:visibility="gone"
        app:passwordToggleEnabled="true">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/dialog_input"
            style="@style/Widget.Nin.TextInput.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="textPassword"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dialog_cancel"
            style="@style/Widget.Nin.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target"
            android:text="@string/action_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dialog_confirm"
            style="@style/Widget.Nin.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height_compact"
            android:layout_marginStart="@dimen/space_sm"
            android:text="@string/action_confirm" />

    </LinearLayout>

</LinearLayout>
