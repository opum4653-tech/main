<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nin_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingTop="@dimen/screen_top_inset"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingBottom="@dimen/screen_bottom_inset">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Nin.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    style="@style/Text.Nin.SectionLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/wallet_current_balance" />

                <TextView
                    android:id="@+id/text_balance"
                    style="@style/Text.Nin.ScreenTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/state_loading" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Payment methods -->
        <TextView
            style="@style/Text.Nin.SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/deposit_payment_method" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/method_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:id="@+id/text_no_methods"
            style="@style/Text.Nin.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:paddingTop="@dimen/space_2xl"
            android:paddingBottom="@dimen/space_2xl"
            android:text="@string/deposit_error_load_methods"
            android:visibility="gone" />

        <!-- Amount + details -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Nin.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_amount_layout"
                    style="@style/Widget.Nin.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/deposit_amount">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_amount"
                        style="@style/Widget.Nin.TextInput.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/deposit_amount_hint"
                        android:imeOptions="actionNext"
                        android:inputType="numberDecimal"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:id="@+id/account_details_block"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/Text.Nin.SectionLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/deposit_account_details" />

                    <TextView
                        android:id="@+id/text_account_details"
                        style="@style/Text.Nin.Value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:background="@drawable/bg_card"
                        android:padding="@dimen/space_md" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_copy_account"
                        style="@style/Widget.Nin.Button.Outline"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height_compact"
                        android:layout_marginTop="@dimen/space_sm"
                        android:text="@string/action_copy"
                        app:icon="@drawable/ic_check"
                        app:iconSize="@dimen/icon_sm" />

                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_trx_layout"
                    style="@style/Widget.Nin.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:hint="@string/deposit_trx_id">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_trx"
                        style="@style/Widget.Nin.TextInput.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/deposit_trx_hint"
                        android:imeOptions="actionNext"
                        android:inputType="textNoSuggestions"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_note_layout"
                    style="@style/Widget.Nin.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:hint="@string/deposit_sender_note">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_note"
                        style="@style/Widget.Nin.TextInput.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="text"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_submit_deposit"
                    style="@style/Widget.Nin.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/space_xl"
                    android:text="@string/deposit_submit" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_submit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="@color/nin_primary"
                    app:trackColor="@color/nin_surface_variant"
                    app:trackThickness="2dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
