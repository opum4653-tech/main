<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Nin.Card.Inner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/screen_gutter_wide"
    android:layout_marginTop="@dimen/space_sm"
    android:layout_marginEnd="@dimen/screen_gutter_wide">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_md">

        <ImageView
            android:id="@+id/plan_selected"
            android:layout_width="@dimen/icon_md"
            android:layout_height="@dimen/icon_md"
            android:contentDescription="@string/purchase_select_duration"
            android:src="@drawable/ic_check_circle"
            app:tint="@color/nin_text_secondary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/plan_title"
                style="@style/Text.Nin.ItemTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/plan_description"
                style="@style/Text.Nin.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:ellipsize="end"
                android:maxLines="2" />

        </LinearLayout>

        <TextView
            android:id="@+id/plan_price"
            style="@style/Text.Nin.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:textColor="@color/nin_primary" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
