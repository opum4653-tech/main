<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nin_background"
    android:orientation="vertical">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/chat_refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/message_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingTop="@dimen/space_md"
            android:paddingEnd="@dimen/screen_gutter"
            android:paddingBottom="@dimen/space_md" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <View style="@style/Widget.Nin.Divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingBottom="@dimen/space_sm">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_message_layout"
            style="@style/Widget.Nin.TextInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/ticket_chat_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_message"
                style="@style/Widget.Nin.TextInput.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="5" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_send"
            style="@style/Widget.Nin.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height"
            android:layout_marginStart="@dimen/space_sm"
            android:minWidth="0dp"
            android:text="@string/action_send"
            app:icon="@drawable/ic_chat"
            app:iconSize="@dimen/icon_sm" />

    </LinearLayout>

</LinearLayout>
