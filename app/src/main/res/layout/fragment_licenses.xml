<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/licenses_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nin_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingTop="@dimen/screen_top_inset"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingBottom="@dimen/screen_bottom_inset">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Current active license + its live countdown -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/active_license_card"
                style="@style/Widget.Nin.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:contentDescription="@string/cd_license_timer"
                            android:src="@drawable/ic_timer"
                            app:tint="@color/nin_primary" />

                        <TextView
                            style="@style/Text.Nin.SectionLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:layout_weight="1"
                            android:text="@string/licenses_current_active"
                            android:textColor="@color/nin_primary" />

                        <TextView
                            android:id="@+id/active_status"
                            style="@style/Widget.Nin.Badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_success"
                            android:textColor="@color/nin_success" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/active_clock"
                        style="@style/Text.Nin.Clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        android:background="@drawable/bg_terminal"
                        android:paddingStart="@dimen/space_xl"
                        android:paddingTop="@dimen/space_md"
                        android:paddingEnd="@dimen/space_xl"
                        android:paddingBottom="@dimen/space_md" />

                    <TextView
                        style="@style/Text.Nin.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="@string/clock_caption" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/keys_header"
                    style="@style/Text.Nin.SectionLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_refresh_keys"
                    style="@style/Widget.Nin.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target"
                    android:text="@string/licenses_refresh_keys"
                    app:icon="@drawable/ic_refresh"
                    app:iconSize="@dimen/icon_sm" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/keys_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/text_empty"
                style="@style/Text.Nin.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:paddingTop="@dimen/space_2xl"
                android:paddingBottom="@dimen/space_2xl"
                android:text="@string/licenses_no_licenses"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_buy_key"
                style="@style/Widget.Nin.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/licenses_buy_key" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
