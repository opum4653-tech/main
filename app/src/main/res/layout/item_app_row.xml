<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Nin.Card.Inner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_md"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="@dimen/space_md"
        android:paddingBottom="@dimen/space_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="@dimen/icon_box_sm"
                android:layout_height="@dimen/icon_box_sm"
                android:background="@drawable/bg_circle">

                <ImageView
                    android:id="@+id/app_icon"
                    android:layout_width="@dimen/icon_lg"
                    android:layout_height="@dimen/icon_lg"
                    android:layout_gravity="center"
                    android:contentDescription="@string/cd_kernel_icon"
                    android:src="@drawable/ic_dashboard" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/app_label"
                    style="@style/Text.Nin.ItemTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/app_package"
                    style="@style/Text.Nin.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:ellipsize="end"
                    android:maxLines="1" />

            </LinearLayout>

            <TextView
                android:id="@+id/app_badge"
                style="@style/Widget.Nin.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/app_expand"
                style="@style/Widget.Nin.Button.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/action_expand"
                app:icon="@drawable/ic_expand_more"
                app:iconSize="@dimen/icon_md" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/process_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/Text.Nin.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/denylist_processes_label" />

            <LinearLayout
                android:id="@+id/process_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:orientation="vertical" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
