<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nin_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingTop="@dimen/screen_top_inset"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingBottom="@dimen/screen_bottom_inset">

        <!-- Auto-detected environment -->
        <TextView
            style="@style/Text.Nin.SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bug_section_environment" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Nin.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    style="@style/Text.Nin.ItemTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/bug_auto_metrics" />

                <TextView
                    android:id="@+id/text_device"
                    style="@style/Text.Nin.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm" />

                <TextView
                    android:id="@+id/text_kernel"
                    style="@style/Text.Nin.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Report body -->
        <TextView
            style="@style/Text.Nin.SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/bug_section_details" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Nin.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_title_layout"
                    style="@style/Widget.Nin.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/bug_issue_title">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_title"
                        style="@style/Widget.Nin.TextInput.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="textCapSentences"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_description_layout"
                    style="@style/Widget.Nin.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:hint="@string/bug_description">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_description"
                        style="@style/Widget.Nin.TextInput.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:hint="@string/bug_description_hint"
                        android:inputType="textCapSentences|textMultiLine"
                        android:minHeight="160dp" />

                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:id="@+id/row_attach_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:background="@drawable/bg_card"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/row_min_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_md"
                    android:paddingEnd="@dimen/space_md">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Nin.ItemTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/bug_attach_log" />

                        <TextView
                            style="@style/Text.Nin.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            android:text="@string/bug_attach_log_hint" />

                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_attach_log"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_submit_bug"
                    style="@style/Widget.Nin.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/space_xl"
                    android:text="@string/bug_submit" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_submit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="@color/nin_primary"
                    app:trackColor="@color/nin_surface_variant"
                    app:trackThickness="2dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
