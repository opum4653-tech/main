<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/nin_surface_variant" />
            <corners android:radius="@dimen/radius_item" />
            <stroke android:width="1dp" android:color="@color/nin_outline_variant" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/nin_surface_raised" />
            <corners android:radius="@dimen/radius_item" />
            <stroke android:width="1dp" android:color="@color/nin_primary" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/nin_primary_container" />
            <corners android:radius="@dimen/radius_item" />
            <stroke android:width="1dp" android:color="@color/nin_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/nin_surface_variant" />
            <corners android:radius="@dimen/radius_item" />
            <stroke android:width="1dp" android:color="@color/nin_outline_variant" />
        </shape>
    </item>
</selector>
